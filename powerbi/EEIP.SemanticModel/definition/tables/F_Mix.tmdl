	partition F_Mix = m
		mode: import
		source =
				let
				    Source = Sql.Database(Serveur, Base),
				    Vue = Source{[Schema = "bi", Item = "MixJour"]}[Data],
				    Colonnes = Table.SelectColumns(Vue, {"Zone", "Jour", "Famille", "Source", "EnergieMWh", "Completude"}),
				    Typees = Table.TransformColumnTypes(Colonnes, {{"Zone", type text}, {"Jour", type date}, {"Famille", type text}, {"Source", type text}, {"EnergieMWh", type number}, {"Completude", type number}}, "en-US")
				in
