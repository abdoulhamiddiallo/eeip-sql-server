		isHidden
		lineageTag: 6f440562-b2c2-5c25-810b-bbc9174b82b6
		summarizeBy: none
		sourceColumn: Zone

		annotation SummarizationSetBy = Automatic

	column Jour
		dataType: dateTime
		isHidden
		formatString: dd/MM/yyyy
