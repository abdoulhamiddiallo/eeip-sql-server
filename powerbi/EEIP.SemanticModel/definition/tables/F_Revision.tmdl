/// Valeurs remplacées par une version plus fiable, conservées par les tables temporelles.
table F_Revision
	lineageTag: 0309f2b8-e5b3-5d20-93cd-4ca85efd864f

	column Source
		dataType: string
		isHidden
		lineageTag: 9c95c9f3-aa99-57d6-8000-3e3091b736c0
		summarizeBy: none
		sourceColumn: Source

		annotation SummarizationSetBy = Automatic

	column Indicateur
		dataType: string
		lineageTag: ae543240-0e96-5a20-8fe8-0e9a4e49d9bc
		summarizeBy: none
		sourceColumn: Indicateur

		annotation SummarizationSetBy = Automatic

	column MoisRevision
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: e59c2965-bf24-5ef3-b3ce-b485835751f3
		summarizeBy: none
		sourceColumn: MoisRevision

		annotation SummarizationSetBy = Automatic

	column Versions
		dataType: int64
		formatString: #,0
		lineageTag: 8dc1b425-cd63-5103-98bf-effe3f13cd94
		summarizeBy: none
		sourceColumn: Versions

		annotation SummarizationSetBy = Automatic

	partition F_Revision = m
		mode: import
		source =
				let
				    Source = Sql.Database(Serveur, Base),
				    Vue = Source{[Schema = "bi", Item = "vw_Revision"]}[Data],
				    Colonnes = Table.SelectColumns(Vue, {"Source", "Indicateur", "MoisRevision", "Versions"}),
				    Typees = Table.TransformColumnTypes(Colonnes, {{"Source", type text}, {"Indicateur", type text}, {"MoisRevision", type date}, {"Versions", Int64.Type}}, "en-US")
				in
				    Typees

	annotation PBI_ResultType = Table
