	measure 'Prix ménages classement' = IF ( SELECTEDVALUE ( D_Zone[TypeZone] ) = "PAYS", [Prix ménages (année)] )
		formatString: 0.000
		displayFolder: 07 Europe
		lineageTag: 4381a6e7-1dc3-563e-8408-73f479bb6b57

	measure 'Couleur prix ménages' =
			VAR z = SELECTEDVALUE ( D_Zone[Zone] )
			RETURN IF ( z = "FR", "#F7C948", "#2E7F86" )
		displayFolder: 00 Contexte
		lineageTag: eb9a06df-0e26-5eb4-bd29-2d5071792af0

	/// Fin du dernier chargement réussi : la plateforme se met à jour toutes les heures.
	measure 'Fraîcheur' =
			VAR d = CALCULATE ( MAX ( F_Lot[Fin] ), REMOVEFILTERS (), F_Lot[Statut] IN { "SUCCES", "PARTIEL" } )
			RETURN "●  Données à jour : " & FORMAT ( d, "dd/mm/yyyy" ) & " à " & FORMAT ( d, "HH" ) & " h " & FORMAT ( d, "nn" )
		displayFolder: 00 Contexte
		lineageTag: 3c6c30fb-d6c6-522d-afd5-d580d5f11ac0

	measure Valeurs = SUM ( F_Volume[Valeurs] )
		formatString: #,0
		displayFolder: 08 Plateforme
		lineageTag: 216dc09f-2f63-5336-9ee7-e7589f128afd

	measure 'Valeurs · contexte' =
			VAR n = SUM ( F_Volume[Series] )
			RETURN "dans " & FORMAT ( n, "#,0" ) & " séries"
		displayFolder: 08 Plateforme
		lineageTag: d44616c1-9e5e-5fd7-b57e-646eb031c4f9

	measure 'Séries' = SUM ( F_Volume[Series] )
		formatString: #,0
		displayFolder: 08 Plateforme
		lineageTag: 14c088da-90c3-58b1-805f-34b273117ad4

	measure 'Sources · contexte' = FORMAT ( DISTINCTCOUNT ( F_Volume[Source] ), "0" ) & " producteurs"
		displayFolder: 08 Plateforme
		lineageTag: 93d4b040-8b14-5e8e-830c-000f27807ae0

	measure Profondeur = YEAR ( MIN ( F_Volume[Premier] ) )
		formatString: 0
		displayFolder: 08 Plateforme
		lineageTag: 682f5603-4155-5a47-a4b6-37ca7f0689c8

	measure 'Profondeur · contexte' = "jusqu'au " & FORMAT ( MAX ( F_Volume[Dernier] ), "dd/mm/yyyy" )
		displayFolder: 08 Plateforme
		lineageTag: f7c3b8a4-8479-589b-8ed1-f48a9bca5211

	measure Lots = COUNTROWS ( F_Lot )
		formatString: #,0
		displayFolder: 08 Plateforme
		lineageTag: c864823f-a8a6-5cce-9b8a-ccfff6b85e30

	measure 'Lots · contexte' =
			VAR ok = CALCULATE ( COUNTROWS ( F_Lot ), F_Lot[Statut] IN { "SUCCES", "TERMINE" } )
			RETURN FORMAT ( ok + 0, "#,0" ) & " réussis"
		displayFolder: 08 Plateforme
		lineageTag: f4648571-dd0d-5ea5-9434-f4b267242663

	/// Valeurs remplacées par une version plus fiable (temps réel, puis consolidé, puis définitif), gardées par les tables temporelles.
	measure 'Révisions' = SUM ( F_Revision[Versions] ) + 0
		formatString: #,0
		displayFolder: 08 Plateforme
		lineageTag: 24a97ea0-8db0-5833-98ba-fe6b44890812

	measure 'Révisions · contexte' = "versions historisées"
		displayFolder: 08 Plateforme
		lineageTag: 12c43142-020f-5dd1-9d9b-94e167490534

	measure Partitions = COUNTROWS ( F_Partition )
		formatString: #,0
		displayFolder: 08 Plateforme
		lineageTag: 70b56e6a-bdb1-5e21-8745-e30b8cb4361e

	measure 'Partitions · contexte' =
			VAR g = SUM ( F_Partition[Mo] )
			RETURN FORMAT ( g, "#,0" ) & " Mo compressés"
		displayFolder: 08 Plateforme
		lineageTag: ff42df5f-ccb1-5b35-88e6-77c6ca8f0ded

	measure 'Lignes stockées' = SUM ( F_Partition[Lignes] )
		formatString: #,0
		displayFolder: 08 Plateforme
		lineageTag: f6016e8e-9a62-5718-b3b8-eaab71e23e0c

	measure 'Anomalies qualité' = SUM ( F_Qualite[Nombre] ) + 0
		formatString: #,0
		displayFolder: 08 Plateforme
		lineageTag: da5d19a4-a6fa-5e38-af8c-47e5ce17d143

	/// Couleur fixe de chaque source.
	measure 'Couleur source' = SELECTEDVALUE ( D_Source[Couleur], "#9DB8B6" )
		displayFolder: 00 Contexte
		lineageTag: 92c1d665-78e1-5cb6-8f1e-fafa5604433a

	measure 'Couleur statut lot' =
			SWITCH ( SELECTEDVALUE ( F_Lot[Statut] ), "SUCCES", "#4ADE80", "TERMINE", "#4ADE80", "PARTIEL", "#F7C948", "EN_COURS", "#5AA9FF",
			    "ECHEC", "#FF8A8A", "#FFFFFF" )
		displayFolder: 00 Contexte
		lineageTag: aa832734-4310-5810-a239-46060e914cbd

