			RETURN IF ( ISBLANK ( fr ), "énergie importée", "France : " & FORMAT ( fr, "0" ) & " %" )
		displayFolder: 07 Europe
		lineageTag: 8fb7dac2-a7ab-5d21-ab34-879cdf8cf06f

	measure 'Prix ménages France' = CALCULATE ( [Prix ménages (année)], REMOVEFILTERS ( D_Zone ), D_Zone[Zone] = "FR" )
		formatString: 0.000" €"
		displayFolder: 07 Europe
		lineageTag: 97060b22-9c35-5c60-be9d-48487a690588

	measure 'Prix ménages France · contexte' =
			VAR u = CALCULATE ( [Prix ménages (année)], REMOVEFILTERS ( D_Zone ), D_Zone[Zone] = "EU27" )
			RETURN IF ( ISBLANK ( u ), "par kWh, TTC", "par kWh, UE : " & FORMAT ( u, "0.000" ) & " €" )
		displayFolder: 07 Europe
		lineageTag: 28cef3c6-3831-50f0-92af-b126e1125e1c

	measure 'Prix ménages le plus élevé' =
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( D_Zone[NomCourt] ), REMOVEFILTERS ( D_Zone ), D_Zone[TypeZone] = "PAYS" ), "v", [Prix ménages (année)] )
			VAR r = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [v] ) ), [v], DESC )
			RETURN COALESCE ( MAXX ( r, D_Zone[NomCourt] ), "-" )
		displayFolder: 07 Europe
		lineageTag: bd3a8a2b-1207-55c1-b6ec-362f1a199d54

	measure 'Prix ménages le plus élevé · contexte' =
			VAR t = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( D_Zone[NomCourt] ), REMOVEFILTERS ( D_Zone ), D_Zone[TypeZone] = "PAYS" ), "v", [Prix ménages (année)] )
			VAR r = TOPN ( 1, FILTER ( t, NOT ISBLANK ( [v] ) ), [v], DESC )
			VAR v = MAXX ( r, [v] )
			RETURN IF ( ISBLANK ( v ), " ", FORMAT ( v, "0.000" ) & " € par kWh" )
		displayFolder: 07 Europe
		lineageTag: ca3db2f5-fa5e-592a-89f8-4be93a26bd53

	measure 'Intensité Eurostat France' = CALCULATE ( [Intensité Eurostat (année)], REMOVEFILTERS ( D_Zone ), D_Zone[Zone] = "FR" )
		formatString: #,0" g/kWh"
		displayFolder: 07 Europe
		lineageTag: 1c76d6bc-d71c-5f61-b2bf-147659680376

	measure 'Intensité Eurostat France · contexte' =
			VAR u = CALCULATE ( [Intensité Eurostat (année)], REMOVEFILTERS ( D_Zone ), D_Zone[Zone] = "EU27" )
			RETURN IF ( ISBLANK ( u ), "mix Eurostat", "UE : " & FORMAT ( u, "0" ) & " g/kWh" )
		displayFolder: 07 Europe
		lineageTag: 44b07b96-5c88-5f3c-a0ce-dc4723bf3592

	measure 'Renouvelables · Union européenne' = CALCULATE ( [Renouvelables officielles], REMOVEFILTERS ( D_Zone ), D_Zone[Zone] = "EU27" )
		formatString: 0.0" %"
