	/// Prix spot moyen à cette heure, zone de marché du système choisi.
	measure 'Prix · heure' = CALCULATE ( [Prix · heure brut], REMOVEFILTERS ( D_Zone ), TREATAS ( VALUES ( D_Zone[ZonePrix] ), D_Zone[Zone] ) )
