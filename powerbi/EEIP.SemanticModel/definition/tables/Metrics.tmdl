table Metrics
	lineageTag: fdd2b1a2-e1c9-5e6b-99ff-6832c3925fb8

	/// Année retenue par le segment, sinon la dernière année complète.
	measure 'Année choisie' = SELECTEDVALUE ( 'Choix Année'[Année], YEAR ( TODAY () ) - 1 )
		formatString: 0
		displayFolder: 00 Contexte
		lineageTag: ffa8701d-cf5b-5904-9fe4-2654956eecba

	/// Le dernier jour complet : l'année en cours s'arrête là.
	measure 'Dernier jour' =
			VAR d = CALCULATE ( MAX ( F_Mix[Jour] ), REMOVEFILTERS () )
			RETURN MIN ( d, TODAY () - 1 )
		formatString: dd/MM/yyyy
		displayFolder: 00 Contexte
		lineageTag: 557ddcf9-7297-5acf-b492-f32ca8f1bb76

	measure 'Période' =
			VAR a = [Année choisie]
			RETURN IF ( a >= YEAR ( TODAY () ), "du 1er janvier au " & FORMAT ( [Dernier jour], "d mmmm yyyy" ), "année " & FORMAT ( a, "0" ) )
		displayFolder: 00 Contexte
		lineageTag: aeff7907-3e78-5569-876a-d328ff935097

	measure 'Zone choisie' = SELECTEDVALUE ( D_Zone[NomCourt], "France" )
		displayFolder: 00 Contexte
		lineageTag: 5c5cb025-ceab-59ed-bd88-7fa875bb618a

	/// Couleur fixe de chaque famille, la même sur toutes les pages.
	measure 'Couleur famille' = SELECTEDVALUE ( D_Famille[Couleur], "#7F93AA" )
		displayFolder: 00 Contexte
		lineageTag: f1bfb9d2-af9e-5f63-8428-c9ebc26f326c

	/// Production nette, en TWh, hors stockage (le pompage est une consommation).
	measure Production = DIVIDE ( CALCULATE ( SUM ( F_Mix[EnergieMWh] ), KEEPFILTERS ( NOT D_Famille[Famille] IN { "STOCKAGE", "VECTEURS" } ) ), 1000000 )
		formatString: #,0.0" TWh"
		displayFolder: 01 Système électrique
		lineageTag: b2c1fe44-efa7-5ec3-b48d-830919b508f6

	/// Consommation intérieure, en TWh.
	measure Consommation = DIVIDE ( SUM ( F_Conso[ConsoMWh] ), 1000000 )
		formatString: #,0.0" TWh"
		displayFolder: 01 Système électrique
		lineageTag: 7801113e-cb12-505d-8164-4d544550957d

	measure 'Production bas carbone' = CALCULATE ( [Production], KEEPFILTERS ( D_Famille[BasCarbone] = 1 ) )
		formatString: #,0.0" TWh"
		displayFolder: 01 Système électrique
		lineageTag: 34e236c1-29c8-54d9-a4c7-1d5bec24eb18

	measure 'Production renouvelable' = CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Renouvelable] = 1 ) )
		formatString: #,0.0" TWh"
		displayFolder: 01 Système électrique
		lineageTag: 74f563d1-64f2-5c1e-a736-8cce3e89f286

	measure 'Part bas carbone' = DIVIDE ( [Production bas carbone], [Production] )
		formatString: 0.0%
		displayFolder: 01 Système électrique
		lineageTag: 538d166a-9df6-5622-9d3b-14ecb2a97400

	measure 'Part renouvelable' = DIVIDE ( [Production renouvelable], [Production] )
		formatString: 0.0%
		displayFolder: 01 Système électrique
		lineageTag: 4bcb1c5d-4f49-58b9-8fed-4a3178fb34df

	measure 'Nucléaire' = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] = "NUCLEAIRE" ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: e8054b6b-373c-50b8-8307-b36942da7a1b

	measure Hydraulique = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] = "HYDRAULIQUE" ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: 9c94b832-d4c3-5a76-a470-74844ee2b6bd

	measure 'Éolien' = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] = "EOLIEN" ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: d5a6b8cf-345a-5df0-8771-b3707a3afddc

	measure Solaire = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] = "SOLAIRE" ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: bddc3784-2bcc-5609-8c45-04209daf5126

	measure 'Bioénergies' = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] = "BIOENERGIES" ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: 2c43ad7c-5d20-5cfe-99ea-06ed737b9f4e

	measure Gaz = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] = "GAZ" ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: c3643c47-ebb2-57a3-9543-2a0a7230f2bd

	measure Charbon = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] = "CHARBON" ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: d74ec3fd-2863-5021-9f03-c8c293a4a492

	measure 'Fioul et autres' = IF ( MAX ( D_Jour[Jour] ) > [Dernier jour], BLANK (), CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] IN { "AUTRES", "PETROLE", "THERMIQUE" } ) ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: a96b5b5f-f30f-5688-a6a6-a0693d5eabc5

	measure 'Thermique fossile' = CALCULATE ( [Production], KEEPFILTERS ( D_Famille[Famille] IN { "GAZ", "CHARBON", "PETROLE", "THERMIQUE" } ) )
		formatString: #,0.0
		displayFolder: 01 Système électrique
		lineageTag: 5f283924-4610-5e65-a64c-edbfe9b0b464

	/// Grammes de CO2 par kWh produit, calculés par le mix du jour et le facteur d'émission de chaque famille.
	measure 'Intensité estimée' = DIVIDE ( SUM ( F_Carbone[EmissionsT] ) * 1000, SUM ( F_Carbone[ProductionMWh] ) )
		formatString: #,0" g/kWh"
		displayFolder: 05 Carbone
		lineageTag: 6b9e6942-cdb4-5ab9-9350-98ec84e2935a

	/// Publiée par RTE (éCO2mix), France seulement.
	measure 'Intensité mesurée' = AVERAGE ( F_Carbone[IntensiteMesuree] )
		formatString: #,0" g/kWh"
		displayFolder: 05 Carbone
		lineageTag: a14f781b-276f-5d97-a0e7-0dbbc794296c

	/// La mesure de RTE quand elle existe, sinon l'estimation.
	measure 'Intensité' =
			VAR me = [Intensité mesurée]
			RETURN IF ( NOT ISBLANK ( me ), me, [Intensité estimée] )
		formatString: #,0" g/kWh"
		displayFolder: 05 Carbone
		lineageTag: 9b2c7f68-50e8-5b2d-be2f-da584ac0eb64

	/// Millions de tonnes de CO2.
	measure 'Émissions' = DIVIDE ( SUM ( F_Carbone[EmissionsT] ), 1000000 )
		formatString: #,0.0" Mt"
		displayFolder: 05 Carbone
		lineageTag: 3bd60311-b2a4-5688-a51a-c98c4fb163de

	measure Exportations = DIVIDE ( SUM ( F_Echange[ExportMWh] ), 1000000 )
		formatString: #,0.0" TWh"
		displayFolder: 04 Échanges
		lineageTag: bbefb8e4-d683-57aa-bfac-499353d59f55

	measure Importations = DIVIDE ( SUM ( F_Echange[ImportMWh] ), 1000000 )
		formatString: #,0.0" TWh"
		displayFolder: 04 Échanges
		lineageTag: 0ae72768-f6ad-58ea-bda2-6fb052d555b3

	/// Positif : le pays vend plus d'électricité à ses voisins qu'il ne leur en achète.
	measure 'Solde exportateur' =
			VAR e = [Exportations]
			VAR i = [Importations]
			RETURN IF ( ISBLANK ( e ) && ISBLANK ( i ), BLANK (), e - i )
		formatString: +#,0.0" TWh";-#,0.0" TWh";0" TWh"
		displayFolder: 04 Échanges
		lineageTag: 3004d264-416e-55fe-928c-bbb7184e7805

	measure 'Volume échangé' = [Exportations] + [Importations]
		formatString: #,0.0" TWh"
		displayFolder: 04 Échanges
		lineageTag: aab6120c-b3b5-59c4-82da-65ebf760b7c7

	/// Prix spot moyen du marché à un jour (base), en €/MWh.
	measure 'Prix moyen' = AVERAGE ( F_Prix[PrixMoyen] )
		formatString: #,0.0" €/MWh"
		displayFolder: 03 Prix
		lineageTag: fc41946d-2173-557e-97a2-80a1268e6193

	/// Heures où le prix spot est passé sous zéro.
	measure 'Heures négatives' = SUM ( F_Prix[HeuresNegatives] )
		formatString: #,0" h"
		displayFolder: 03 Prix
		lineageTag: 48f28f5e-85bb-5252-8e81-7050e821151f

	/// Le prix de la zone de marché du système choisi.
	measure 'Prix · zone' = CALCULATE ( [Prix moyen], REMOVEFILTERS ( D_Zone ), TREATAS ( VALUES ( D_Zone[ZonePrix] ), D_Zone[Zone] ) )
		formatString: #,0.0" €/MWh"
		displayFolder: 03 Prix
		lineageTag: 4e7e1110-770a-574e-9650-3651b728efd2

	measure 'Heures négatives · zone' = CALCULATE ( [Heures négatives], REMOVEFILTERS ( D_Zone ), TREATAS ( VALUES ( D_Zone[ZonePrix] ), D_Zone[Zone] ) )
		formatString: #,0" h"
		displayFolder: 03 Prix
		lineageTag: 47b4bfa6-c9f3-5e9c-8fb7-1932ae4e04fa

	measure 'Solde · zone' = CALCULATE ( [Solde exportateur], REMOVEFILTERS ( D_Zone ), TREATAS ( VALUES ( D_Zone[Pays] ), D_Zone[Zone] ) )
		formatString: +#,0.0" TWh";-#,0.0" TWh";0" TWh"
		displayFolder: 04 Échanges
		lineageTag: 1d6f08ff-6cd8-5f10-95fb-838b5ad6a773

	measure 'Exportations · zone' = CALCULATE ( [Exportations], REMOVEFILTERS ( D_Zone ), TREATAS ( VALUES ( D_Zone[Pays] ), D_Zone[Zone] ) )
		formatString: #,0.0" TWh"
		displayFolder: 04 Échanges
		lineageTag: 6c446dc9-788e-5cbe-9cb1-1d974d78f434

	measure 'Importations · zone' = CALCULATE ( [Importations], REMOVEFILTERS ( D_Zone ), TREATAS ( VALUES ( D_Zone[Pays] ), D_Zone[Zone] ) )
		formatString: #,0.0" TWh"
		displayFolder: 04 Échanges
		lineageTag: 94897071-cacf-570b-8c4e-ca388c8cc80e

	measure 'Consommation (année)' =
			VAR a = [Année choisie]
			VAR f = IF ( a >= YEAR ( TODAY () ), [Dernier jour], DATE ( a, 12, 31 ) )
			RETURN CALCULATE ( [Consommation], REMOVEFILTERS ( D_Jour ), D_Jour[Jour] >= DATE ( a, 1, 1 ), D_Jour[Jour] <= f )
		formatString: #,0.0" TWh"
		displayFolder: 01 Système électrique
		lineageTag: b44a776a-8c3d-53bb-81e3-3a71fc30f9ea

	measure 'Consommation (année) · N-1' =
			VAR a = [Année choisie]
			VAR f = IF ( a >= YEAR ( TODAY () ), [Dernier jour], DATE ( a, 12, 31 ) )
			RETURN CALCULATE ( [Consommation], REMOVEFILTERS ( D_Jour ), D_Jour[Jour] >= DATE ( a - 1, 1, 1 ), D_Jour[Jour] <= EDATE ( f, -12 ) )
		formatString: #,0.0" TWh"
		displayFolder: 00 Contexte
		lineageTag: 7f3c2866-fc21-550f-80d3-bece1a55f260

	measure 'Consommation (année) Δ' =
			VAR v = [Consommation (année)]
			VAR p = [Consommation (année) · N-1]
			RETURN IF ( NOT ISBLANK ( v ) && NOT ISBLANK ( p ) && p <> 0, v / p - 1 )
		formatString: 0.0%
		displayFolder: 00 Contexte
		lineageTag: 1832ba00-e256-5339-8636-bca4e57f0cfb

	measure 'Consommation · contexte' =
			VAR d = [Consommation (année) Δ]
			VAR a = [Année choisie]
			VAR ref = IF ( a >= YEAR ( TODAY () ), "même période " & FORMAT ( a - 1, "0" ), FORMAT ( a - 1, "0" ) )
			RETURN "" & IF ( ISBLANK ( d ), "année " & FORMAT ( a, "0" ),
			    IF ( d > 0, "▲ ", IF ( d < 0, "▼ ", "■ " ) ) & FORMAT ( d * 100, "+0.0;-0.0;0.0" ) & " %" & " vs " & ref )
		displayFolder: 00 Contexte
		lineageTag: 82cf6675-7e97-5f2d-a1dd-a35fc30c50b3

	measure 'Consommation · contexte · couleur' =
			VAR d = [Consommation (année) Δ] * 1
			RETURN IF ( ISBLANK ( d ) || d = 0, "#CFE3E1", IF ( d > 0, "#4ADE80", "#FF6B5B" ) )
		displayFolder: 00 Contexte
		lineageTag: 713096f2-8a7f-503a-8f49-e63a9efdaf14

	measure 'Production (année)' =
			VAR a = [Année choisie]
			VAR f = IF ( a >= YEAR ( TODAY () ), [Dernier jour], DATE ( a, 12, 31 ) )
			RETURN CALCULATE ( [Production], REMOVEFILTERS ( D_Jour ), D_Jour[Jour] >= DATE ( a, 1, 1 ), D_Jour[Jour] <= f )
		formatString: #,0.0" TWh"
		displayFolder: 01 Système électrique
		lineageTag: 5693e35e-a122-5d1c-bac1-c7515b57f105

	measure 'Production (année) · N-1' =
			VAR a = [Année choisie]
			VAR f = IF ( a >= YEAR ( TODAY () ), [Dernier jour], DATE ( a, 12, 31 ) )
			RETURN CALCULATE ( [Production], REMOVEFILTERS ( D_Jour ), D_Jour[Jour] >= DATE ( a - 1, 1, 1 ), D_Jour[Jour] <= EDATE ( f, -12 ) )
